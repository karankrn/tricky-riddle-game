<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- Active Game Content -->
    <LinearLayout
        android:id="@+id/layoutGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Alias, Hearts, Pause -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#37474F"
                android:text="👤 Player" />

            <TextView
                android:id="@+id/tvHearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#D32F2F"
                android:text="❤️❤️❤️"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="⏸"
                android:textSize="14sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Score and Level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                android:text="⭐ Score: 0" />

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                android:text="Level 1" />
        </LinearLayout>

        <!-- Riddle Question Box -->
        <TextView
            android:id="@+id/tvRiddle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="95dp"
            android:padding="14dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#E91E63"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- 4 Option Choices -->
        <Button
            android:id="@+id/btnOption1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOption2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOption3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOption4"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- 2 Lifelines: Hint & Skip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:textSize="13sp"
                android:text="💡 Hint (1)" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:textSize="13sp"
                android:text="🚀 Skip (1)" />
        </LinearLayout>

        <!-- Sticky AdMob Banner at bottom of screen -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />
    </LinearLayout>

    <!-- Pause / Main Menu Overlay -->
    <LinearLayout
        android:id="@+id/layoutMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 GAME PAUSED"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnResume"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="▶️ Resume"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="🔄 Restart Game"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnViewLeaderboard"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="🏆 High Scores"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnChangeAlias"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="✏️ Change Name" />
    </LinearLayout>
</FrameLayout>
