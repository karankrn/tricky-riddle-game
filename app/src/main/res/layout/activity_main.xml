<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EC"> <!-- Warm, joyful soft cream background -->

    <!-- Main Game View -->
    <LinearLayout
        android:id="@+id/layoutGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar: Hero Tag, Hearts, and Pause -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#37474F"
                android:text="👤 Hero: Player" />

            <TextView
                android:id="@+id/tvHearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="❤️❤️❤️"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="⏸"
                android:textSize="14sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Stats Bar: Score & Level with Trophy Emoji -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"
                android:text="⭐ Score: 0" />

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5E35B1"
                android:text="🏆 Level 1" />
        </LinearLayout>

        <!-- Mascot & Speech Reaction Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Mascot Owl Logo -->
            <ImageView
                android:id="@+id/ivMascot"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/app_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Mascot Owl" />

            <!-- Mascot Speech Bubble -->
            <TextView
                android:id="@+id/tvMascotDialogue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/speech_bubble_card"
                android:elevation="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#5D4037"
                android:text="Can you crack this puzzle?" />
        </LinearLayout>

        <!-- Riddle Question Box -->
        <TextView
            android:id="@+id/tvRiddle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:padding="14dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:background="@drawable/speech_bubble_card"
            android:elevation="3dp"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Hint Text Box -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:textSize="13sp"
            android:textStyle="italic|bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- 4 Candy Option Buttons -->
        <Button
            android:id="@+id/btnOption1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_candy_blue"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOption2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_candy_green"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOption3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_candy_orange"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOption4"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_candy_pink"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <!-- Lifelines: Hint & Skip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:textSize="13sp"
                android:text="💡 Hint (1)" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="13sp"
                android:text="🚀 Skip (1)" />
        </LinearLayout>

        <!-- Sticky AdMob Banner at bottom -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />
    </LinearLayout>

    <!-- Pause Menu Modal -->
    <!-- Pause / Main Menu Overlay -->
    <LinearLayout
        android:id="@+id/layoutMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Rounded Menu White Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/speech_bubble_card"
            android:elevation="8dp"
            android:padding="24dp">

            <!-- Menu Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 GAME PAUSED"
                android:textColor="#5E35B1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Quick In-Game Summary -->
            <TextView
                android:id="@+id/tvMenuStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 1 • Score: 0 • ❤️❤️❤️"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- 1. Resume -->
            <Button
                android:id="@+id/btnResume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_candy_green"
                android:text="▶️ Keep Playing"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- 2. Sound Toggle (Audio On/Off) -->
            <Button
                android:id="@+id/btnToggleSound"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_candy_blue"
                android:text="🔊 Sound: ON"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- 3. High Scores -->
            <Button
                android:id="@+id/btnViewLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_candy_orange"
                android:text="🏆 Hall of Fame"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- 4. Change Name -->
            <Button
                android:id="@+id/btnChangeAlias"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_candy_pink"
                android:text="✏️ Change Hero Name"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- 5. Restart -->
            <Button
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔄 Restart Game"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginBottom="6dp" />

            <!-- 6. Quit App -->
            <Button
                android:id="@+id/btnQuitGame"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🚪 Exit Game"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
